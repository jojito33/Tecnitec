{
  "name": "tecnitec-core",
  "version": "31.82.4",
  "description": "Sistema de Gestión TECNITEC",
  "author": "TECNITEC <tecnitec@example.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:x86": "electron-rebuild -f -w better-sqlite3 --arch ia32 && electron-builder --win --ia32",
    "build:both": "electron-builder --win",
    "rebuild:x86": "electron-rebuild -f -w better-sqlite3 --arch ia32",
    "prebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.10.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tecnitec.core",
    "productName": "TECNITEC CORE",
    "copyright": "Copyright © 2025 TECNITEC",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://jojito33.github.io/Tecnitec/updates/"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "splash.html",
      "splash.jpg",
      "index.html",
      "license.js",
      "backup.service.js",
      "package.json",
      "logo.png",
      "!dist/**",
      "!logs/**",
      "!backups/**",
      "!wa-session/**",
      "!.git/**",
      "!flutter_whatsapp_bot/**",
      "!**/*.md",
      "!**/*.map"
    ],
    "win": {
      "icon": "logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TECNITEC-CORE-portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TECNITEC CORE",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true
    }
  }
}
